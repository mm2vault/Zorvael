# Bu dosyayı ".env" adıyla kopyala. Kimseyle paylaşma, GitHub'a yükleme (.gitignore zaten engelliyor).

# Anahtarlar virgülle ayrılır. Biri bitince/limiti dolunca otomatik sıradakine geçilir.
ZORVAEL_API_KEYS=anahtar1,anahtar2,anahtar3
# İstersen tek tek de yazabilirsin: ANTHROPIC_API_KEY_1=..., ANTHROPIC_API_KEY_2=...

ZORVAEL_MODEL=claude-sonnet-5-5
ZORVAEL_VOICE=tr-TR-AhmetNeural
ZORVAEL_WAKE=zorvael
